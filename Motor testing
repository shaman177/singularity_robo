import time
import RPi.GPIO as GPIO

# Direction pins (BCM numbering)
IN1, IN2 = 17, 27  # Left Motor
IN3, IN4 = 22, 23  # Right Motor

GPIO.setmode(GPIO.BCM)
for pin in [IN1, IN2, IN3, IN4]:
  GPIO.setup(pin, GPIO.OUT)
  GPIO.output(pin, GPIO.LOW)


def stop():
  for pin in [IN1, IN2, IN3, IN4]:
    GPIO.output(pin, GPIO.LOW)


def forward():
  GPIO.output(IN1, GPIO.HIGH)
  GPIO.output(IN2, GPIO.LOW)
  GPIO.output(IN3, GPIO.HIGH)
  GPIO.output(IN4, GPIO.LOW)


def backward():
  GPIO.output(IN1, GPIO.LOW)
  GPIO.output(IN2, GPIO.HIGH)
  GPIO.output(IN3, GPIO.LOW)
  GPIO.output(IN4, GPIO.HIGH)


try:
  print("1. Testing FORWARD for 2 seconds...")
  forward()
  time.sleep(2)

  print("Stopping for 1 second...")
  stop()
  time.sleep(1)

  print("2. Testing BACKWARD for 2 seconds...")
  backward()
  time.sleep(2)

  print("Test Complete. Motors stopped.")
  stop()

except KeyboardInterrupt:
  stop()
finally:
  GPIO.cleanup()
